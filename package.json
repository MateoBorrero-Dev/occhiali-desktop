{
  "name": "optica-desktop",
  "version": "0.9.0",
  "productName": "Occhiali",
  "private": true,
  "description": "Sistema de gestión de escritorio para una óptica pequeña.",
  "author": "Occhiali",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:electron": "npm run test:electron:sqlite",
    "test:electron:sqlite": "electron scripts/verify-electron-sqlite.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package:win": "node scripts/patch-electron-builder-collector.cjs && npm run build && electron-builder --win nsis --x64",
    "package:win:dir": "node scripts/patch-electron-builder-collector.cjs && npm run build && electron-builder --win dir --x64",
    "verify:package": "node scripts/verify-packaged-app.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.occhiali.desktop",
    "productName": "Occhiali",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/win32-x64.node"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-addon-api/**/*",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux-*.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!**/*.db",
      "!**/*.db-journal",
      "!**/*.db-shm",
      "!**/*.db-wal",
      "!**/*.ocbackup",
      "!**/*.ocbackup.partial",
      "!**/.restore-staging*",
      "!**/*.restore-rollback",
      "!**/*.restore-state.json*",
      "!**/security.json",
      "!**/backup-settings.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Occhiali",
      "artifactName": "Occhiali-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Occhiali",
      "uninstallDisplayName": "Occhiali",
      "deleteAppDataOnUninstall": false
    }
  }
}
